{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sphinx Autobuild",
            "type": "debugpy",
            "request": "launch",
            "module": "sphinx_autobuild",
            "args": [
                "-b", "dirhtml",
                "docs",
                "docs/_build/html"
            ],
            "justMyCode": false,
            "preLaunchTask": "Bootstrap venv",
            "python": "${workspaceFolder}/.ve/bin/python",
            "windows": {
                "python": "${workspaceFolder}\\.ve\\Scripts\\python.exe"
            }
        }
    ]
}
